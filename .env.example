# ===== 应用 =====
APP_ENV=local
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8420

# ===== 数据库 =====
# 本地默认 SQLite；上云换成 Neon 的 Postgres 连接串（asyncpg 驱动）
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/neondb?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./data/zhiwei.db

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
# 只允许这个 Telegram User ID 使用（访问控制，必填）
TELEGRAM_USER_ID=
# Webhook 模式才需要（Render 部署时用）
TELEGRAM_PROXY=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# 本地开发用长轮询，云上用 webhook
BOT_MODE=polling

# ===== 模型 =====
# ollama | gemini | openrouter | deepseek | cloudflare
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Cloudflare Workers AI（免费额度）
# account_id 在控制台右侧栏「Account ID」，没有它无法调用
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# 国内可直连，不需要代理
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 只读 HTTP 接口的访问令牌（不填则 /api/v1/* 全部 401）
ADMIN_API_TOKEN=

# ===== 人格 =====
AI_NAME=知微
USER_NAME=木川

# ===== 记忆 =====
# 低风险信息是否自动入库（重要/敏感信息永远走确认）
MEMORY_AUTO_SAVE=true
